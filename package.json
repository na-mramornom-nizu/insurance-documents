{
  "name": "insurance-documents",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4188",
    "build": "tsc --noEmit && vite build",
    "test": "tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4188",
    "assets": "tsx scripts/setup-assets.ts",
    "package": "tsx scripts/package.ts",
    "build:sourcecraft": "tsc --noEmit && vite build --mode sourcecraft && tsx scripts/package.ts"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bcryptjs": "3.0.3",
    "jszip": "3.10.2",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vite-plugin-singlefile": "^2.3.0"
  }
}
